{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masinyusane.org/schemas/finance-snapshot-1.0.0.json",
  "title": "Masinyusane finance snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "published_at", "payload_sha256", "accounting_year", "source",
    "funder_contracts", "allocation_coverage", "allocation_coverage_caveats", "findings"
  ],
  "$defs": {
    "money": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$" },
    "moneyOrNull": { "anyOf": [ { "$ref": "#/$defs/money" }, { "type": "null" } ] },
    "columnLetter": { "type": "string", "pattern": "^[A-Z]{1,3}$" },
    "completenessReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "enum": ["UNBOUND_ALLOCATION", "ASSERTED_LINE", "MISSING_BUDGET"] },
        "line_id": { "type": "string" },
        "amount": { "$ref": "#/$defs/money" }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id", "sheet_row", "category", "budget", "binding",
        "key_column", "key_column_letter", "category_column_letter", "amount_column_letter",
        "key_values", "allocated_lifetime", "allocated_in_year", "allocated_asserted",
        "allocated_cached", "row_count", "row_count_in_year"
      ],
      "properties": {
        "line_id": { "type": "string" },
        "sheet_row": { "type": "integer", "minimum": 1 },
        "category": { "type": ["string", "null"] },
        "budget": { "$ref": "#/$defs/moneyOrNull" },
        "binding": { "enum": ["derived", "asserted"] },
        "key_column": { "type": ["string", "null"] },
        "key_column_letter": { "anyOf": [ { "$ref": "#/$defs/columnLetter" }, { "type": "null" } ] },
        "category_column_letter": { "anyOf": [ { "$ref": "#/$defs/columnLetter" }, { "type": "null" } ] },
        "amount_column_letter": { "anyOf": [ { "$ref": "#/$defs/columnLetter" }, { "type": "null" } ] },
        "key_values": { "type": "array", "items": { "type": "string" } },
        "allocated_lifetime": { "$ref": "#/$defs/moneyOrNull" },
        "allocated_in_year": { "$ref": "#/$defs/moneyOrNull" },
        "allocated_asserted": { "$ref": "#/$defs/moneyOrNull" },
        "allocated_cached": { "$ref": "#/$defs/moneyOrNull" },
        "row_count": { "type": ["integer", "null"], "minimum": 0 },
        "row_count_in_year": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "contract_code", "block_label", "period_label", "sheet_row", "in_scope_year", "row_count_in_year",
        "budget_total", "allocated_total_lifetime", "allocated_total_in_year", "remaining",
        "unbound_allocated_lifetime", "unbound_allocated_in_year",
        "complete", "completeness_reasons", "lines"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
        "contract_code": { "type": ["string", "null"], "minLength": 1 },
        "block_label": { "type": "string", "minLength": 1 },
        "period_label": { "type": ["string", "null"] },
        "sheet_row": { "type": "integer", "minimum": 1 },
        "in_scope_year": { "type": "boolean" },
        "row_count_in_year": { "type": "integer", "minimum": 0 },
        "budget_total": { "$ref": "#/$defs/moneyOrNull" },
        "allocated_total_lifetime": { "$ref": "#/$defs/money" },
        "allocated_total_in_year": { "$ref": "#/$defs/money" },
        "remaining": { "$ref": "#/$defs/moneyOrNull" },
        "unbound_allocated_lifetime": { "$ref": "#/$defs/money" },
        "unbound_allocated_in_year": { "$ref": "#/$defs/money" },
        "complete": { "type": "boolean" },
        "completeness_reasons": { "type": "array", "items": { "$ref": "#/$defs/completenessReason" } },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/line" } }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category_2", "category_2_variants", "spend", "funded", "unfunded",
        "by_contract", "unbound_allocated", "unbound_row_count", "complete", "completeness_reasons"
      ],
      "properties": {
        "category_2": { "type": ["string", "null"] },
        "category_2_variants": { "type": "array", "items": { "type": "string" } },
        "spend": { "$ref": "#/$defs/money" },
        "funded": { "$ref": "#/$defs/money" },
        "unfunded": { "$ref": "#/$defs/money" },
        "by_contract": {
          "type": "object",
          "propertyNames": { "pattern": "^[0-9a-f]{12}$" },
          "additionalProperties": { "$ref": "#/$defs/money" }
        },
        "unbound_allocated": { "$ref": "#/$defs/money" },
        "unbound_row_count": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" },
        "completeness_reasons": { "type": "array", "items": { "$ref": "#/$defs/completenessReason" } }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code", "severity", "in_scope_year", "contract_id", "line_id",
        "key_column", "key_value", "category", "category_2", "sheet_row",
        "amount", "amount_in_year", "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "ORPHAN_CONTRACT_KEY", "WHITESPACE_KEY", "STALE_CACHED_SPENT",
            "OVER_ALLOCATED_COVERAGE", "OVER_ALLOCATED_ROW", "ASSERTED_LINE",
            "MISSING_BUDGET", "CATEGORY_NOT_IN_BLOCK", "MISSING_CONTRACT_KEY", "UNSCANNED_FUNDER_AMOUNT"
          ]
        },
        "severity": { "enum": ["error", "warn", "info"] },
        "in_scope_year": { "type": "boolean" },
        "contract_id": { "type": ["string", "null"] },
        "line_id": { "type": ["string", "null"] },
        "key_column": { "type": ["string", "null"] },
        "key_value": { "type": ["string", "null"] },
        "category": { "type": ["string", "null"] },
        "category_2": { "type": ["string", "null"] },
        "sheet_row": { "type": ["integer", "null"] },
        "amount": { "$ref": "#/$defs/moneyOrNull" },
        "amount_in_year": { "$ref": "#/$defs/moneyOrNull" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z-[0-9a-f]{6}$" },
    "published_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "accounting_year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workbook_name", "workbook_date", "sha256", "size_bytes", "modified_at"],
      "properties": {
        "workbook_name": { "type": "string", "minLength": 1 },
        "workbook_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "modified_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
      }
    },
    "funder_contracts": { "type": "array", "items": { "$ref": "#/$defs/contract" } },
    "allocation_coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } },
    "allocation_coverage_caveats": { "type": "array", "items": { "$ref": "#/$defs/completenessReason" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  }
}
